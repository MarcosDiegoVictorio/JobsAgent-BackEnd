{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Agent": {
    "RunEveryMinutes": 360,
    "MinScoreToNotify": 7,
    "MaxJobsPerRun": 40,
    "CandidateProfilePath": "profile/candidate.md",
    "DatabasePath": "jobs.db",
    "EnableBackgroundWorker": false,
    "LlmProvider": "Gemini",
    "IncludeTitleKeywords": [
      ".net",
      "dotnet",
      "asp.net",
      "c#",
      "c sharp",
      "analista de sistemas",
      "análise de sistemas",
      "analista de desenvolvimento",
      "analista programador",
      "analista desenvolvedor",
      "system analyst",
      "systems analyst",
      "systems analysis",
      "desenvolvedor .net",
      "programador .net",
      ".net developer",
      ".net programmer",
      "programador c#",
      "full stack .net"
    ],
    "ExcludeTitleKeywords": []
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.1-flash-lite"
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-5-5",
    "MaxTokens": 1500
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": ""
  },
  "Rss": {
    "Feeds": [
      {
        "Name": "We Work Remotely - Back-End",
        "Url": "https://weworkremotely.com/categories/remote-back-end-programming-jobs.rss"
      },
      {
        "Name": "We Work Remotely - Programming",
        "Url": "https://weworkremotely.com/categories/remote-programming-jobs.rss"
      },
      {
        "Name": "We Work Remotely - Front-End",
        "Url": "https://weworkremotely.com/categories/remote-front-end-programming-jobs.rss"
      },
      {
        "Name": "We Work Remotely - DevOps",
        "Url": "https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss"
      },
      {
        "Name": "Remotive - Software Development",
        "Url": "https://remotive.com/remote-jobs/feed?category=software-dev"
      },
      {
        "Name": "Remotive - DevOps",
        "Url": "https://remotive.com/remote-jobs/feed?category=devops"
      },
      {
        "Name": "Jobicy - Remote Jobs",
        "Url": "https://jobicy.com/?feed=job_feed"
      }
    ]
  },
  "Email": {
    "Enabled": false,
    "Host": "imap.gmail.com",
    "Port": 993,
    "User": "",
    "AppPassword": "",
    "Folder": "INBOX",
    "MaxAgeDays": 3,
    "FromContains": [
      "linkedin.com",
      "indeed.com",
      "gupy.io",
      "glassdoor.com"
    ],
    "LinkContains": [
      "/jobs/view",
      "viewjob",
      "gupy.io",
      "/job/"
    ]
  },
  "Auth": {
    "GoogleClientId": "",
    "AdminEmail": "",
    "JwtSigningKey": "",
    "Issuer": "JobAgent",
    "Audience": "JobAgent.Client",
    "TokenLifetimeMinutes": 30,
    "FrontendUrl": "http://localhost:4200"
  },
  "Database": {
    "Provider": "SQLite",
    "SqlitePath": "jobs.db",
    "ConnectionString": ""
  }
}
